prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: qudo-mldsa
Description: QUDO ML-DSA Post-Quantum Digital Signature Library (FIPS 204)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lqudo-mldsa
Cflags: -I${includedir}/qudo-mldsa
Requires: libcrypto

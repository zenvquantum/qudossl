#!/bin/bash
# Pre-commit hook: clang-format check over all project-owned C sources.
# Fails if any file needs reformatting.

set -e

cd "$(dirname "$0")/.."

# Project-owned C/H sources; vendored *-native code is excluded.
ROOTS=(
    src include tests tools
    qudo-mlkem/src   qudo-mlkem/include
    qudo-mldsa/src   qudo-mldsa/include
    qudo-slhdsa/src  qudo-slhdsa/include
)

existing=()
for r in "${ROOTS[@]}"; do
    [ -d "$r" ] && existing+=("$r")
done

if [ ${#existing[@]} -eq 0 ]; then
    exit 0
fi

files=$(find "${existing[@]}" -type f \( -name '*.c' -o -name '*.h' \) \
    | grep -vE '(mlkem-native|mldsa-native|slhdsa-native)/' || true)

if [ -z "$files" ]; then
    exit 0
fi

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format not installed — skipping style check."
    exit 0
fi

violations=0
for f in $files; do
    if ! clang-format --dry-run --Werror "$f" 2>/dev/null; then
        echo "  style violation: $f"
        violations=1
    fi
done

if [ $violations -ne 0 ]; then
    echo ""
    echo "clang-format violations detected. Fix with:"
    echo "    clang-format -i <files>"
    echo ""
    exit 1
fi

exit 0
